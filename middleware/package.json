{
  "name": "@jenlow/security",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "bundle:check": "esbuild src/index.ts --bundle --format=esm --platform=neutral --external:node:crypto --external:cloudflare:workers --outfile=dist/worker.check.js --log-level=warning"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "wrangler": "^4.46.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
