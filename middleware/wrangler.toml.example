# Isolated staging only. Do not use production database or signing secret.
name = "jenlow-security-staging"
main = "src/index.ts"
compatibility_date = "2026-10-25"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
preview_urls = false
# Accessible only via the authorized product gateway's private service binding.
[vars]
ENVIRONMENT = "staging"
PRODUCT = "network"
ALLOWED_ORIGIN = "http://localhost:8081"
[[d1_databases]]
binding = "DB"
database_name = "jenlow-staging"
database_id = "REPLACE_WITH_STAGING_DATABASE_ID"
# Historical migration chain is for isolated tests only; do not auto-apply.
[triggers]
crons = ["*/15 * * * *"]
